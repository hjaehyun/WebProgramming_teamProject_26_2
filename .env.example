# Copy to .env.local. Never commit secrets. The original backend's variable names are retained.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
APP_URL=http://127.0.0.1:3001
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=
# Existing automatic worker's 32+ character shared secret (server only).
CRON_SECRET=
# Weather (data.go.kr > 기상청_단기예보 조회서비스, server only). Leave empty to keep weather off.
# Apply supabase/migrations/20261112003000_entry_weather.sql BEFORE setting this.
KMA_SERVICE_KEY=
# OAuth provider credentials are configured in Supabase, not in browser code.
# SUPABASE_URL/SUPABASE_PUBLISHABLE_KEY are supported aliases for teammate compatibility.
