# Copy to .env.local (never commit .env.local). Server-only: no NEXT_PUBLIC_ prefix.
# Only the social login routes (/api/auth/oauth/*, /api/auth/callback) read these.

# Supabase (Dashboard > Project Settings > API Keys). Same values as the backend's .env.local.
# Kakao/Google client keys are not here: they live only in the Supabase dashboard.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=
